  "fitting_policy": {
    "model": "reference-precision",
    "preprocessing_selector": "raw only; reject every other preprocessing combination",
    "storage": "Owned f64 Level buffers explicitly holding f32-quantized fitting values; no f32 memory-saving claim",
    "input": "u8 gray divided by 255 in f32; metric f32 depth promoted to f64; original inclusive finite depth admission and NaN holes",
    "separable_operator": "Replicate edges. Each horizontal tap product is f32; accumulate the three products in order in f64 and store f32. Each vertical product is f32; accumulate in order in f64 and store f32. Recompute horizontal samples locally to avoid an additional full-plane intermediate. All taps participate, including zero times NaN.",
    "initial_filter": "Gaussian3 weights [0.25,0.5,0.25] on gray and depth using the separable operator; NaNs propagate",
    "normalization": "Once, initial rounded correspondences in row-major order; f64 means/gains, gain=0.5/mean; require minimum count and finite positive means/gains before mutation; each multiplied gray value stored as f32 without clipping",
    "pyramid": "Floor width/2,height/2, each scheduled level >=3x3; gray separable Gaussian3 then left-associated f32 (a+b+c+d)/4; depth same f32 mean without Gaussian; nonfinite propagates; halve fx,fy,cx,cy",
    "matching": "Retain native f64 source unproject ((x-cx)*z/fx,(y-cy)*z/fy,z), proper pose transform and projection. trunc(projected+0.5), finite signed bounds before usize, finite selected target depth and original metric difference gate. No target uniqueness or bitwise external correspondence equivalence claim.",
    "fitting_point": "Separate source XYZ: ((x-cx)*z*(1/fx)), ((y-cy)*z*(1/fy)), z each cast f32 then promoted f64; proper pose transform in f64. Skip a fitting row if this transformed point is not finite with positive z.",
    "gradients": "Sobel separable horizontal [-1,0,1],vertical [1,2,1] for x and swapped for y; f32 operator output promoted f64 then multiplied by 1/8. Each nonfinite depth derivative becomes zero. Local surrogate, not an exact derivative of rounded lookup.",
    "residuals": "Photometric target-source subtraction in f32 promoted f64. Depth target f32 promoted f64 minus transformed quantized point.z in f64.",
    "normal_equations": "Existing residual_jacobians, f64; multiply each J and residual by sqrt(1-depth_weight) or sqrt(depth_weight), then accumulate in f64 with unit weight in existing fixed 16-row tile order. No unchecked external solver behavior.",
    "solve": "Existing finite-checked pivoted f64 Gaussian solver; singular/nonfinite failure remains failure",
    "pose_update": "Proper left Rz(delta_z)*Ry(delta_y)*Rx(delta_x), t_new=R_step*t_old+delta_translation; finite proper AbsolutePose admission",
    "iterations": "All original 20,10,5 scheduled updates; no epsilon early exit",
    "final_admission": "Original full-resolution raw bilinear final statistics, count/fraction/depth/error gates; no filtered final admission",
    "ownership": "Safe borrowed Rust input; Python owns four image copies before GIL release; CPU only, explicit device transfers unchanged",
    "working_bytes": "32*sum(floor-pyramid pixels)+64*base_pixels+max(ceil(height/16)*sizeof(Normal),48*sizeof(f64)); checked arithmetic/options before allocation; excludes caller/Python inputs, allocator metadata and stacks",
    "workers": "At most four private CPU workers, deterministic ordered tiles; WASM serial"
  },
